{
  "targets": {
    "workhorse": {
      "providerInstanceId": "muse",
      "model": "muse-spark-1.3-contributor",
      "options": {
        "reasoningEffort": "xhigh"
      }
    },
    "advisor": {
      "providerInstanceId": "muse",
      "model": "muse-wonder-1.0",
      "options": {
        "reasoningEffort": "max"
      }
